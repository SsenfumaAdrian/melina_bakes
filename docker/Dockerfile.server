# Melina Bakes Server Dockerfile
# Multi-stage build for optimal image size

# ==================== BUILD STAGE ====================
FROM dart:3.5-sdk AS build

WORKDIR /app

# Copy pubspec files first for better layer caching
COPY pubspec.yaml pubspec.lock ./
RUN dart pub get

# Copy source code
COPY . .

# Generate serverpod code and build
RUN dart pub get
RUN dart run serverpod_cli generate
RUN dart compile exe bin/main.dart -o bin/server

# ==================== RUNTIME STAGE ====================
FROM debian:bookworm-slim AS runtime

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN groupadd -r melina && useradd -r -g melina melina

WORKDIR /app

# Copy compiled binary
COPY --from=build /app/bin/server /app/bin/server
COPY --from=build /app/config/ /app/config/
COPY --from=build /app/migrations/ /app/migrations/
COPY --from=build /app/web/ /app/web/

# Create directories for uploads and logs
RUN mkdir -p /app/uploads /app/logs && chown -R melina:melina /app

USER melina

EXPOSE 8080 8081

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["/app/bin/server"]
