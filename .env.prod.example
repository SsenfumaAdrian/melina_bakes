# Melina Bakes — Production Environment Variables
# Copy this file to .env.prod and fill in real secrets.
# Used by docker/docker-compose.prod.yml
# .env.prod is git-ignored. NEVER commit real values.

DB_USER=melina_admin
DB_PASSWORD=<generate-secure-password>
DB_NAME=melina_bakes
DATABASE_URL=postgresql://melina_admin:<password>@postgres:5432/melina_bakes
REDIS_URL=redis://:<redis-password>@redis:6379
REDIS_PASSWORD=<generate-secure-password>

JWT_SECRET=<generate-64-char-random-string>

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@melinabakes.com
SMTP_PASSWORD=<app-specific-password>
SMTP_FROM_ADDRESS=noreply@melinabakes.com

STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=